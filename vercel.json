{
  "version": 2,
  "routes": [
    {
      "src": "/participante",
      "dest": "/participant.html"
    },
    {
      "src": "/galeria",
      "dest": "/index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
